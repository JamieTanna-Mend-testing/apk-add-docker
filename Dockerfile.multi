# Same base image/digest as ./Dockerfile.
FROM cgr.dev/chainguard/wolfi-base:latest@sha256:1d95114038f76513a9ace6fca107d5582b08c65981f81f61cb56bf7fd2ef216d

# Multiple packages in a single, line-continued `apk add`, mixing pinned
# and unpinned packages, to exercise multi-line parsing.
RUN apk upgrade --no-cache && \
    apk add --no-cache \
        bash=5.2.37-r0 \
        ca-certificates-bundle \
        curl=8.9.1-r4 \
        jq=1.7.1-r4

ENV APP_HOST=0.0.0.0
ENV APP_PORT=5000
